  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PlanetInfo
  planetName: Solar System
  description: 'The Solar System is made up of the Sun and all the planets that move
    around it.

    The Sun is at the center and gives light and heat to the planets.


    The
    planets rotate on their own axis and orbit around the Sun at different speeds.

    This
    is why days and years are different on each planet.

'
  planetImage: {fileID: 21300000, guid: 679705a49a2e42d4ab86ccfd7faf1f79, type: 3}
